GROQ_API_KEY=your_groq_api_key

# Tenant API keys map (tenant:key,tenant:key)
VERITAS_API_KEYS=company-a:key-company-a,company-b:key-company-b

# Optional admin key for cross-tenant operations
VERITAS_ADMIN_KEY=super-admin-key

# Requests allowed per API key per minute
VERITAS_RATE_LIMIT_PER_MINUTE=60
